---
import Layout from '../../layouts/Layout.astro';
import Editor from '../../components/Editor';
import { copy } from '../../lib/i18n';
import type { Lang } from '../../lib/project';
export function getStaticPaths() { return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }]; }
const lang = Astro.params.lang as Lang; const t = copy[lang];
---
<Layout lang={lang}>
  <section class="hero wrap">
    <div class="hero-copy"><span class="eyebrow"><span class="tiny-star" aria-hidden="true">✳</span> {t.badge}</span><h1>{t.hero1}<br />{t.hero2}<br /><span class="hero-emphasis">{t.hero3}<svg viewBox="0 0 400 14" preserveAspectRatio="none" aria-hidden="true"><path d="M2 10C100 0 260 1 398 9" fill="none" stroke="currentColor" stroke-width="5" /></svg></span></h1><p>{t.intro}</p><a class="button button-primary hero-cta" href="#studio">{t.cta}<span aria-hidden="true">↗</span></a><p class="hero-local"><span aria-hidden="true">✓</span> {t.local}</p></div>
    <div class="hero-art" aria-label={t.previewEmpty}><span class="art-label">{t.heroNote}</span><div class="art-ring ring-one"></div><div class="art-ring ring-two"></div><div class="art-card art-card-back"><img src={`/hero/${lang}-android.png`} width="1080" height="1920" alt={lang === 'es' ? 'Ejemplo generado: Galaxy S26 con plantilla Degradado' : 'Generated example: Galaxy S26 with the Gradient template'} decoding="async" /></div><div class="art-card art-card-front"><img src={`/hero/${lang}-ios.png`} width="1320" height="2868" alt={lang === 'es' ? 'Ejemplo generado: iPhone 17 con plantilla Editorial' : 'Generated example: iPhone 17 with the Editorial template'} decoding="async" fetchpriority="high" /></div><span class="art-sticker sticker-png">PNG<span>100% FREE</span></span><span class="art-sticker sticker-local"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 10h12v11H6ZM8 10V6a4 4 0 0 1 8 0v4" /></svg>{lang === 'es' ? 'Solo en tu navegador' : 'Only in your browser'}</span><span class="art-spark" aria-hidden="true">✳</span></div>
  </section>
  <div class="benefit-strip wrap"><span><i aria-hidden="true">01 /</i> Google Play &amp; App Store</span><span><i aria-hidden="true">02 /</i> {lang === 'es' ? 'Tu marca, sin límites creativos' : 'Your brand, your creative freedom'}</span><span><i aria-hidden="true">03 /</i> {lang === 'es' ? 'Sin cuentas. Sin API keys.' : 'No accounts. No API keys.'}</span></div>
  <section id="studio" class="studio-section wrap" aria-labelledby="studio-title"><div class="section-heading"><div><span class="eyebrow">{t.studio}</span><h2 id="studio-title">{t.editorTitle}</h2></div><p>{t.editorIntro}</p></div><Editor lang={lang} client:load /><noscript><p class="message">{lang === 'es' ? 'El editor necesita JavaScript para procesar las imágenes en tu navegador. Las páginas informativas se pueden leer sin activarlo.' : 'The editor needs JavaScript to process images in your browser. Informational pages work without it.'}</p></noscript></section>
  <section id="how" class="how-section"><div class="wrap"><span class="eyebrow">{t.howLabel}</span><h2>{t.howTitle}</h2><div class="how-grid">{[1, 2, 3].map((n) => <article><span class="how-number">0{n}</span><h3>{t[`how${n}` as 'how1']}</h3><p>{t[`how${n}Text` as 'how1Text']}</p></article>)}</div></div></section>
  <section id="faq" class="faq-section wrap"><div><span class="eyebrow">FAQ</span><h2>{t.faqTitle}</h2><p>{lang === 'es' ? 'Una herramienta útil también debe ser transparente.' : 'A useful tool should be transparent, too.'}</p></div><div class="faq-list">{[1, 2, 3, 4].map(n => <details><summary>{t[`faq${n}` as 'faq1']}<span aria-hidden="true">+</span></summary><p>{t[`faq${n}a` as 'faq1a']}</p></details>)}</div></section>
</Layout>

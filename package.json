    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@playwright/cli": "0.1.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@webgpu/types": "0.1.74",
